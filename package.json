{
  "name": "plateduae",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @plated/db db:generate",
    "db:migrate": "pnpm --filter @plated/db db:migrate",
    "db:seed-taxonomy": "pnpm --filter @plated/db db:seed-taxonomy",
    "db:seed": "pnpm --filter @plated/db db:seed",
    "db:studio": "pnpm --filter @plated/db db:studio",
    "contracts:generate": "pnpm --filter @plated/contracts generate",
    "api:openapi": "pnpm --filter @plated/api generate:openapi",
    "api-client:generate": "pnpm --filter @plated/api-client generate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
