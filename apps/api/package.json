    "@nestjs/swagger": "^7.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@plated/db": "workspace:*",
    "@plated/shared-types": "workspace:*",
    "@plated/contracts": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "@aws-sdk/client-s3": "^3.1129.0",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
