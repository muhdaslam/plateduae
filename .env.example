# Copy to .env and adjust as needed. This single file is the source of truth
# for docker-compose and all three runtimes (api, web, data-workers).

# --- Postgres (+ PostGIS + pgvector) ---
POSTGRES_USER=plated
POSTGRES_PASSWORD=plated_dev
POSTGRES_DB=plated
DATABASE_URL=postgres://plated:plated_dev@localhost:5432/plated

# --- Redis (cache + Arq broker) ---
REDIS_URL=redis://localhost:6379/0

# --- OpenSearch ---
OPENSEARCH_URL=http://localhost:9200

# --- MinIO (S3-compatible object storage) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_ACCESS_KEY=plated
S3_SECRET_KEY=plated_dev_secret
S3_BUCKET=plated-artefacts
S3_FORCE_PATH_STYLE=true

# --- API (apps/api) ---
API_PORT=3001

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Data workers (services/data-workers) ---
DATA_WORKERS_PORT=8000
